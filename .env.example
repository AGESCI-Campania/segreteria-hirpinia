# ─── Django ───────────────────────────────────────────────────────────────────
DJANGO_SETTINGS_MODULE=config.settings.dev
SECRET_KEY=cambiami-in-produzione
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,segreteria.agescihirpinia.it,catello.agescihirpinia.it
CSRF_TRUSTED_ORIGINS=https://segreteria.agescihirpinia.it,https://catello.agescihirpinia.it

# ─── PostgreSQL ───────────────────────────────────────────────────────────────
POSTGRES_DB=catello
POSTGRES_USER=catello
POSTGRES_PASSWORD=cambiami
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# ─── Email ────────────────────────────────────────────────────────────────────
# Provider attivo: console | locmem | smtp | gmail_service_account |
#                  gmail_oauth | microsoft_graph
EMAIL_PROVIDER=console
DEFAULT_FROM_EMAIL=Catello <segreteria@zonahirpinia.org>

# --- smtp (Exchange on-premises, relay interni, provider transazionali) -------
# Attiva UNA sola fra TLS e SSL, mai entrambe, mai nessuna delle due.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_TIMEOUT=20

# --- gmail_service_account (consigliato per Gmail/Workspace) -----------------
# Chiave JSON del service account: contenuto su una riga, oppure percorso del file
# montato in sola lettura. Delega di dominio limitata allo scope gmail.send.
GMAIL_SERVICE_ACCOUNT_JSON=
GMAIL_SERVICE_ACCOUNT_FILE=
# Casella impersonata: deve coincidere con DEFAULT_FROM_EMAIL
GMAIL_MITTENTE=segreteria@zonahirpinia.org

# --- gmail_oauth (ripiego: vedi i vincoli in § 8.3 della progettazione) ------
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=

# --- microsoft_graph (Microsoft 365 / Exchange Online) -----------------------
# Permesso APPLICATIVO Mail.Send + Application Access Policy che limita l'app
# alla sola casella mittente (obbligatoria: senza, l'app puo' inviare da
# qualunque cassetta del tenant).
MS_TENANT_ID=
MS_CLIENT_ID=
MS_CLIENT_SECRET=
MS_MITTENTE=segreteria@zonahirpinia.org

# ─── Applicazione ─────────────────────────────────────────────────────────────
# Domini ammessi per l'assegnazione di ruoli effettivi (non deleghe)
DOMINI_RUOLI_EFFETTIVI=campania.agesci.it,zonahirpinia.org
# Email della segreteria di zona
EMAIL_SEGRETERIA=segreteria@zonahirpinia.org
# Causale predefinita dei bonifici (sovrascrivibile da impostazioni e in export)
CAUSALE_BONIFICO_DEFAULT=Contributo FoCa {anno} - AGESCI Zona Hirpinia

# ─── Media e static ───────────────────────────────────────────────────────────
MEDIA_ROOT=./media
STATIC_ROOT=./staticfiles

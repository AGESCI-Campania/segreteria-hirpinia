# Template delle informazioni necessarie per un deploy di produzione.
#
# Questo file NON contiene dati sensibili: è pensato per essere versionato
# (a differenza di .env.example non descrive l'app ma "come raggiungere e
# configurare il server"). Per usarlo:
#
#   cp deploy-info.env.example docs/ignored/deploy-produzione.env
#
# poi compila la copia in docs/ignored/ (cartella già esclusa da .gitignore)
# con i valori reali: MAI committare la copia compilata, solo questo template
# vuoto va su GitHub. Per le variabili dell'applicazione vera e propria (quelle
# che finiscono nel .env sul server) resta valido .env.example: qui sotto sono
# solo referenziate per nome, non duplicate — vedi docs/docker.md § Produzione.

# ─────────────────────────────────────────────────────────────────────────────
# ACCESSO SERVER
# ─────────────────────────────────────────────────────────────────────────────

# Metodo di connessione: "alias_ssh_config" (preferito) oppure "manuale"
SSH_METODO=alias_ssh_config

# --- Se SSH_METODO=alias_ssh_config ------------------------------------------
# Nome dell'Host già definito in ~/.ssh/config (Host/HostName/User/IdentityFile
# vivono lì, non qui): es. "catello-prod"
SSH_HOST_ALIAS=

# --- Se SSH_METODO=manuale ----------------------------------------------------
SSH_HOST=
SSH_PORT=22
SSH_USER=
# Autenticazione: "chiave" oppure "password"
SSH_AUTH_TIPO=chiave
# Percorso locale della chiave privata (solo se SSH_AUTH_TIPO=chiave).
# MAI il contenuto della chiave in questo file, solo il percorso.
SSH_KEY_PATH=
# Solo se SSH_AUTH_TIPO=password: NON scrivere la password qui, nemmeno nella
# copia compilata in docs/ignored/ — comunicarla a voce o per canale sicuro
# al momento dell'esecuzione, mai per iscritto in un file.
SSH_PASSWORD_CANALE=

# L'utente SSH ha privilegi sudo? (si/no)
# Serve per i passi che configure-prod.sh NON esegue mai da solo
# (mkdir /srv/<nome-istanza>, installazione Docker Engine se mancante, TLS/certbot).
SSH_SUDO=
# Se sudo richiede password (non NOPASSWD in /etc/sudoers): stesso principio
# di SSH_PASSWORD_CANALE, NON scrivere la password qui né nella copia
# compilata, solo il canale con cui va comunicata al momento dell'uso.
SUDO_PASSWORD_CANALE=

# ─────────────────────────────────────────────────────────────────────────────
# STATO DEL SERVER
# ─────────────────────────────────────────────────────────────────────────────

# Docker Engine + plugin Compose già installati? (si/no)
DOCKER_GIA_INSTALLATO=

# Percorso di installazione sul server (default suggerito: /opt/catello)
DEPLOY_PATH=/opt/catello

# Il repository è già clonato sul server? (si/no) Se sì, a quale commit/branch?
DEPLOY_REPO_GIA_CLONATO=

# ─────────────────────────────────────────────────────────────────────────────
# RETE E REVERSE PROXY
# ─────────────────────────────────────────────────────────────────────────────

# Dominio/i reali che puntano al server (senza schema, separati da virgola)
DEPLOY_DOMINI=

# Scelta reverse proxy (vedi ./configure-prod.sh): nginx-docker | nginx-host |
# apache-host
DEPLOY_PROXY_SCELTA=

# C'è già un proxy/TLS/certbot configurato sul server per questo dominio?
# (si/no — se sì, quale: nginx/apache/altro)
DEPLOY_TLS_ESISTENTE=

# ─────────────────────────────────────────────────────────────────────────────
# VARIABILI APPLICATIVE (.env sul server)
# ─────────────────────────────────────────────────────────────────────────────
# Elenco di riferimento delle variabili da valorizzare nel .env di produzione
# sul server (nomi soltanto, i valori NON vanno in questo template né nella
# copia in docs/ignored/ se preferisci comunicarli a voce/canale sicuro).
# Dettaglio di ciascuna in docs/docker.md § "Configura .env di produzione".
#
#   SECRET_KEY, ALLOWED_HOSTS, CSRF_TRUSTED_ORIGINS, SITE_URL,
#   POSTGRES_DB, POSTGRES_USER, POSTGRES_PASSWORD,
#   EMAIL_PROVIDER (+ le variabili del provider scelto, vedi docs/email/README.md),
#   DOMINI_RUOLI_EFFETTIVI, EMAIL_SEGRETERIA, CAUSALE_BONIFICO_DEFAULT,
#   DJANGO_ADMINS (opzionale), EMAIL_MAILPIT_HOST/PORT (opzionale)

# Provider email scelto per la produzione: smtp | gmail_service_account |
# gmail_oauth | microsoft_graph (mai console/locmem, bloccati in produzione)
DEPLOY_EMAIL_PROVIDER=

# ─────────────────────────────────────────────────────────────────────────────
# PRIMO SUPERUSER
# ─────────────────────────────────────────────────────────────────────────────

# Chi crea il primo account amministratore: "interattivo" (lo fa l'operatore
# durante il deploy, via `manage.py createsuperuser`) oppure "assistito"
# (l'assistente guida i comandi ma la password si digita solo a schermo,
# mai scritta in questo file)
SUPERUSER_MODALITA=interattivo
SUPERUSER_EMAIL=
